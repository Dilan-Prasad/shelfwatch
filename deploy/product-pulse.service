# Product Pulse — systemd unit
#
# sudo cp deploy/product-pulse.service /etc/systemd/system/product-pulse.service
# sudo systemctl daemon-reload && sudo systemctl enable --now product-pulse

[Unit]
Description=Product Pulse (Exa-powered Walmart product report)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/exa-work-trial/product-pulse
# EXA_API_KEY is read from .env in the working directory by the app itself
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 127.0.0.1 --port 8020
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
